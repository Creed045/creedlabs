# Copy this file to ".env" and fill in your own values.
# Everything prefixed with VITE_ is bundled into the browser — so ONLY public keys go here.
# NEVER put the Supabase service_role / secret key or the Squad SECRET key in this file.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Squad by GTCO → Dashboard → Settings → API Keys & Webhooks
# Use sandbox_pk_... in sandbox/test mode, or pk_... in live mode
VITE_SQUAD_PUBLIC_KEY=pk_0774891bbcc91dc101d82a8b494a7146ed1c3db2