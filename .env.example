# Copy this file to ".env" and fill in your own values.
# Everything prefixed with VITE_ is bundled into the browser — so ONLY public keys go here.
# NEVER put the Supabase service_role / secret key or the Paystack SECRET key in this file.

# Supabase → Project Settings → API (or "Connect" button)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Paystack → Settings → API Keys & Webhooks (use pk_test_... in development, pk_live_... in production)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
